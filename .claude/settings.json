{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__sqlite3-database-query__sqlite3-database-query",
      "Bash(protoc *)"
    ],
    "additionalDirectories": [
      "../library-squirrel-sdk",
      "../library-squirrel-plugin-local",
      "../library-squirrel-plugin-pixiv",
      "../LibrarySquirrel"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-guard.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Read-guard: 大文件整读检查"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/go-check.sh\"",
            "shell": "bash",
            "timeout": 180,
            "asyncRewake": true,
            "statusMessage": "Go 后台编译检查中"
          }
        ]
      }
    ]
  }
}
